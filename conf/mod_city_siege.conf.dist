[worldserver]

###################################################################################################
# mod-city-siege
#
# An enemy war host musters outside a capital, marches through the streets and tries to kill the
# city leader. Defenders of any level can join in.
#
# Routing is automatic. The module reads each city leader's real position out of the `creature`
# table and then generates the marching route with the server's navmesh (mmaps), so no waypoints
# have to be placed by hand for any city. See the "Route generation" section below.
###################################################################################################

###################################################################################################
# GENERAL
###################################################################################################

#
#    CitySiege.Enabled
#        Description: Master switch for the module.
#        Default:     1 - Enabled
#                     0 - Disabled
CitySiege.Enabled = 1

#
#    CitySiege.DebugMode
#        Description: Verbose logging, including every generated route node.
#        Default:     0
CitySiege.DebugMode = 0

#
#    CitySiege.TimerMin
#        Description: Minimum number of minutes between automatic sieges.
#        Default:     120
CitySiege.TimerMin = 120

#
#    CitySiege.TimerMax
#        Description: Maximum number of minutes between automatic sieges.
#        Default:     240
CitySiege.TimerMax = 240

#
#    CitySiege.EventDuration
#        Description: How long a siege lasts, in minutes. If the city leader is still alive when
#                     the clock runs out, the defenders win.
#        Default:     30
CitySiege.EventDuration = 30

#
#    CitySiege.CinematicDelay
#        Description: Length of the muster (roleplay) phase in seconds. The army is passive and
#                     immune during this window while its officers deliver the RP script.
#        Default:     150
CitySiege.CinematicDelay = 150

#
#    CitySiege.YellFrequency
#        Description: Seconds between roleplay lines and combat taunts.
#        Default:     30
CitySiege.YellFrequency = 30

#
#    CitySiege.AllowMultipleCities
#        Description: Allow sieges in several different cities at the same time. A single city is
#                     never besieged twice at once regardless of this setting.
#        Default:     0
CitySiege.AllowMultipleCities = 0

#
#    CitySiege.AnnounceRadius
#        Description: Radius in yards for local siege chatter (status updates, stage changes).
#                     0 sends those to the whole map.
#        Default:     1500
CitySiege.AnnounceRadius = 1500

#
#    CitySiege.WorldAnnounce
#        Description: Send the big beats (siege starting, assault beginning, city taken/held) to
#                     the entire server rather than just to players near the city.
#        Default:     1
CitySiege.WorldAnnounce = 1

#
#    CitySiege.MinimumLevel
#        Description: Minimum player level considered a participant for scaling and rewards.
#        Default:     1
CitySiege.MinimumLevel = 1

###################################################################################################
# CITY SELECTION
#
# All eight capitals work out of the box because routes are generated automatically.
###################################################################################################

CitySiege.Stormwind.Enabled    = 1
CitySiege.Ironforge.Enabled    = 1
CitySiege.Darnassus.Enabled    = 1
CitySiege.Exodar.Enabled       = 1
CitySiege.Orgrimmar.Enabled    = 1
CitySiege.Undercity.Enabled    = 1
CitySiege.ThunderBluff.Enabled = 1
CitySiege.Silvermoon.Enabled   = 1

###################################################################################################
# ROUTE GENERATION
#
# How the army finds its way from the muster point to the throne room.
#
#   auto   - Ask the server navmesh for a walkable corridor and turn its corners into waypoints.
#            This is the default and needs mmaps to be extracted and enabled. Long marches are
#            stitched together from several pathfinder calls, so a route can cross an entire city.
#   manual - Only use the CitySiege.<City>.WaypointN entries below.
#   direct - No waypoints at all; the army walks straight at the leader. Fine for open cities,
#            poor for anything with walls.
#
# In "auto" mode the configured waypoints are still used as a fallback if route generation fails
# (for example when mmaps are missing). The reason is written to the log and is also shown by
# `.citysiege route <city>`.
#
# Useful commands:
#   .citysiege repath <city|all>   rebuild the cached route
#   .citysiege route <city>        print the current route and how it was produced
#   .citysiege showroute <city>    place visible beacons along the route (run again to remove)
###################################################################################################

#
#    CitySiege.Route.Mode
#        Description: auto | manual | direct
#        Default:     auto
CitySiege.Route.Mode = auto

#
#    CitySiege.Route.AutoDetectLeaderPosition
#        Description: Read each city leader's throne position from the `creature` table instead of
#                     trusting the LeaderX/Y/Z values below. Turn this off only if you have moved
#                     your leaders and want to pin the target by hand.
#        Default:     1
CitySiege.Route.AutoDetectLeaderPosition = 1

#
#    CitySiege.Route.NodeSpacing
#        Description: Minimum distance in yards between two generated waypoints. Lower values hug
#                     the streets more closely at the cost of more nodes.
#        Default:     28
CitySiege.Route.NodeSpacing = 28

#
#    CitySiege.Route.MaxNodes
#        Description: Upper bound on generated waypoints per city. Longer routes are thinned out.
#        Default:     64
CitySiege.Route.MaxNodes = 64

#
#    CitySiege.Route.MaxLegs
#        Description: How many chained pathfinder calls may be used to reach the throne. Each leg
#                     covers one navmesh corridor. Raise this if the log reports that a route
#                     stopped short of the throne.
#        Default:     16
#
#    CitySiege.Route.MaxSlopeDegrees
#        Description: Steepest gradient the war host will march up. Roads and ramps are well under
#                     30; raise this only if a legitimate approach is being rejected, lower it if
#                     the army is cutting over hillsides instead of using the streets.
#        Default:     45
CitySiege.Route.MaxSlopeDegrees = 45

CitySiege.Route.MaxLegs = 24

###################################################################################################
# MUSTER POINTS
#
# Where the attacking army forms up. These are outside each city's main gate.
###################################################################################################

CitySiege.Stormwind.SpawnX = -9161.16
CitySiege.Stormwind.SpawnY = 353.365
CitySiege.Stormwind.SpawnZ = 88.117

CitySiege.Ironforge.SpawnX = -5174.09
CitySiege.Ironforge.SpawnY = -594.361
CitySiege.Ironforge.SpawnZ = 397.853

CitySiege.Darnassus.SpawnX = 9887.36
CitySiege.Darnassus.SpawnY = 1856.49
CitySiege.Darnassus.SpawnZ = 1317.14

CitySiege.Exodar.SpawnX = -4080.80
CitySiege.Exodar.SpawnY = -12193.2
CitySiege.Exodar.SpawnZ = 1.712

CitySiege.Orgrimmar.SpawnX = 1250.33
CitySiege.Orgrimmar.SpawnY = -4412.59
CitySiege.Orgrimmar.SpawnZ = 25.48

CitySiege.Undercity.SpawnX = 1982.26
CitySiege.Undercity.SpawnY = 226.674
CitySiege.Undercity.SpawnZ = 35.951

CitySiege.ThunderBluff.SpawnX = -1558.61
CitySiege.ThunderBluff.SpawnY = -5.071
CitySiege.ThunderBluff.SpawnZ = 5.384

CitySiege.Silvermoon.SpawnX = 9230.47
CitySiege.Silvermoon.SpawnY = -6962.67
CitySiege.Silvermoon.SpawnZ = 5.004

###################################################################################################
# CITY LEADERS
#
# LeaderEntry is the creature the siege is trying to kill. With
# CitySiege.Route.AutoDetectLeaderPosition = 1 (the default) the LeaderX/Y/Z values are only a
# fallback used when that creature has no spawn in the `creature` table.
###################################################################################################

CitySiege.Stormwind.LeaderEntry = 29611
CitySiege.Stormwind.LeaderX = -8441.42
CitySiege.Stormwind.LeaderY = 333.102
CitySiege.Stormwind.LeaderZ = 122.679

CitySiege.Ironforge.LeaderEntry = 2784
CitySiege.Ironforge.LeaderX = -4865.73
CitySiege.Ironforge.LeaderY = -1022.67
CitySiege.Ironforge.LeaderZ = 505.798

CitySiege.Darnassus.LeaderEntry = 7999
CitySiege.Darnassus.LeaderX = 9662.52
CitySiege.Darnassus.LeaderY = 2524.57
CitySiege.Darnassus.LeaderZ = 1360.08

CitySiege.Exodar.LeaderEntry = 17468
CitySiege.Exodar.LeaderX = -3993.71
CitySiege.Exodar.LeaderY = -11413.7
CitySiege.Exodar.LeaderZ = -122.136

CitySiege.Orgrimmar.LeaderEntry = 4949
CitySiege.Orgrimmar.LeaderX = 1919.9
CitySiege.Orgrimmar.LeaderY = -4123.8
CitySiege.Orgrimmar.LeaderZ = 44.3715

CitySiege.Undercity.LeaderEntry = 10181
CitySiege.Undercity.LeaderX = 1290.41
CitySiege.Undercity.LeaderY = 316.247
CitySiege.Undercity.LeaderZ = -57.2376

CitySiege.ThunderBluff.LeaderEntry = 3057
CitySiege.ThunderBluff.LeaderX = -1209.64
CitySiege.ThunderBluff.LeaderY = -112.698
CitySiege.ThunderBluff.LeaderZ = 163.882

CitySiege.Silvermoon.LeaderEntry = 16802
CitySiege.Silvermoon.LeaderX = 9990.5
CitySiege.Silvermoon.LeaderY = -7052.52
CitySiege.Silvermoon.LeaderZ = 45.4464

###################################################################################################
# MANUAL WAYPOINTS (LEGACY / FALLBACK)
#
# Only needed if you set CitySiege.Route.Mode = manual, or if automatic routing cannot run on your
# server (no mmaps). Leave the counts at 0 to rely purely on automatic routing.
#
# Format, per city:
#   CitySiege.<City>.WaypointCount = <n>
#   CitySiege.<City>.Waypoint1.X = ...
#   CitySiege.<City>.Waypoint1.Y = ...
#   CitySiege.<City>.Waypoint1.Z = ...
#   ... up to Waypoint<n>
#
# Use `.citysiege here` while standing on the spot to print coordinates you can paste in.
#
# Worked example (the old hand-placed Stormwind route), left here as a template:
#   CitySiege.Stormwind.WaypointCount = 3
#   CitySiege.Stormwind.Waypoint1.X = -9070.56
#   CitySiege.Stormwind.Waypoint1.Y = 429.37
#   CitySiege.Stormwind.Waypoint1.Z = 94.06
#   CitySiege.Stormwind.Waypoint2.X = -8883.58
#   CitySiege.Stormwind.Waypoint2.Y = 577.11
#   CitySiege.Stormwind.Waypoint2.Z = 93.98
#   CitySiege.Stormwind.Waypoint3.X = -8497.73
#   CitySiege.Stormwind.Waypoint3.Y = 542.96
#   CitySiege.Stormwind.Waypoint3.Z = 98.21
###################################################################################################

CitySiege.Stormwind.WaypointCount    = 0
CitySiege.Ironforge.WaypointCount    = 0
CitySiege.Darnassus.WaypointCount    = 0
CitySiege.Exodar.WaypointCount       = 0
CitySiege.Orgrimmar.WaypointCount    = 0
CitySiege.Undercity.WaypointCount    = 0
CitySiege.ThunderBluff.WaypointCount = 0
CitySiege.Silvermoon.WaypointCount   = 0

###################################################################################################
# ARMY COMPOSITION
###################################################################################################

#
#    CitySiege.SpawnCount.*
#        Description: Size of each rank in the attacking war host.
CitySiege.SpawnCount.Minions    = 15
CitySiege.SpawnCount.Elites     = 5
CitySiege.SpawnCount.MiniBosses = 2
CitySiege.SpawnCount.Leaders    = 1

#
#    CitySiege.Creature.*
#        Description: Creature entries used for the attacking ranks. The defaults are the Mount
#                     Hyjal battle units, which have matching Alliance and Horde models.
CitySiege.Creature.Alliance.Minion   = 17919
CitySiege.Creature.Alliance.Elite    = 17920
CitySiege.Creature.Alliance.MiniBoss = 17921
CitySiege.Creature.Alliance.Defender = 17919

CitySiege.Creature.Horde.Minion   = 17932
CitySiege.Creature.Horde.Elite    = 17933
CitySiege.Creature.Horde.MiniBoss = 17934
CitySiege.Creature.Horde.Defender = 17932

#
#    CitySiege.Creature.<Faction>.Warlords
#        Description: Comma separated pool of named champions who lead an assault. One is picked at
#                     random per siege. The defaults are the opposing faction's own city leaders.
#                     Replace them with custom NPCs if a duplicate Thrall breaks your immersion.
CitySiege.Creature.Alliance.Warlords = 29611,2784,7999,17468
CitySiege.Creature.Horde.Warlords    = 4949,3057,10181,16802

#
#    CitySiege.AggroPlayers / CitySiege.AggroNPCs
#        Description: Whether the war host attacks on sight. If both are 0 the army only fights
#                     back when struck.
CitySiege.AggroPlayers = 1
CitySiege.AggroNPCs    = 1

###################################################################################################
# CITY GARRISON
###################################################################################################

CitySiege.Defenders.Enabled = 1
CitySiege.Defenders.Count   = 10

#
#    CitySiege.Defenders.HoldLineFraction
#        Description: How far along the route the garrison advances before digging in, as a
#                     fraction of the route. 0.5 means they meet the assault halfway; 0 keeps them
#                     at the throne; 1 sends them to the city gates.
#        Default:     0.5
CitySiege.Defenders.HoldLineFraction = 0.5

CitySiege.Defenders.RespawnTime = 45

###################################################################################################
# MARCHING FORMATION
#
# Every unit is given a fixed slot relative to the line of march and keeps it for the whole siege,
# including after it respawns. Without this the entire host walks at the same waypoint and collapses
# into one pile of overlapping models.
#
# The host forms up facing the first leg of its route: minions in front, then elites, then the
# mini-bosses, with the warlord bringing up the rear. The garrison forms a single line facing back
# down the route.
###################################################################################################

#
#    CitySiege.Formation.Spacing
#        Description: Yards between neighbouring units in the same row.
#        Default:     6
CitySiege.Formation.Spacing = 6

#
#    CitySiege.Formation.Width
#        Description: Units per row before a new row starts behind it. Lower this for cities with
#                     narrow streets so ranks are not pushed into the walls.
#        Default:     5
CitySiege.Formation.Width = 5

#
#    CitySiege.Formation.RowDepth
#        Description: Yards between successive rows of the same rank.
#        Default:     6
CitySiege.Formation.RowDepth = 6

#
#    CitySiege.Formation.*Depth
#        Description: Yards each rank marches behind the vanguard.
CitySiege.Formation.MinionDepth   = 0
CitySiege.Formation.EliteDepth    = 14
CitySiege.Formation.MiniBossDepth = 26
CitySiege.Formation.WarlordDepth  = 34

#
#    CitySiege.Formation.Jitter
#        Description: Random wobble in yards applied to each slot, so ranks look like troops rather
#                     than a parade grid. 0 gives perfectly rigid formations.
#        Default:     1.5
CitySiege.Formation.Jitter = 1.5

###################################################################################################
# LEVEL SCALING
#
# The war host is scaled to whoever actually shows up, so a siege is a real fight on a level 20
# server and on a level 80 one.
###################################################################################################

#
#    CitySiege.Scaling.Enabled
#        Description: Scale the army to the players near the city when the siege starts. With this
#                     off, every siege uses CitySiege.Scaling.FallbackLevel.
#        Default:     1
CitySiege.Scaling.Enabled = 1

#
#    CitySiege.Scaling.FallbackLevel
#        Description: Level used when nobody is around, or when scaling is disabled.
#        Default:     80
CitySiege.Scaling.FallbackLevel = 80

#
#    CitySiege.Scaling.MinLevel / MaxLevel
#        Description: Clamp for the computed army level.
CitySiege.Scaling.MinLevel = 20
CitySiege.Scaling.MaxLevel = 83

#
#    CitySiege.Scaling.SampleRadius
#        Description: Radius in yards around the city centre used to sample player levels. Also the
#                     radius in which healing counts toward participation.
#        Default:     600
CitySiege.Scaling.SampleRadius = 600

#
#    CitySiege.Level.*Offset
#        Description: Level of each rank relative to the computed army level.
CitySiege.Level.WarlordOffset  = 3
CitySiege.Level.MiniBossOffset = 2
CitySiege.Level.EliteOffset    = 0
CitySiege.Level.MinionOffset   = -2
CitySiege.Level.DefenderOffset = -1

#
#    CitySiege.Level.MinionSpread
#        Description: Rank-and-file minions roll a level in a band this many levels wide below their
#                     offset, so there is always something a weaker defender can bring down.
#        Default:     4
CitySiege.Level.MinionSpread = 4

#
#    CitySiege.Health.* / CitySiege.Damage.*
#        Description: Health and damage multipliers per rank, applied on top of the level scaling.
CitySiege.Health.WarlordMultiplier  = 12.0
CitySiege.Health.MiniBossMultiplier = 5.0
CitySiege.Health.EliteMultiplier    = 2.5
CitySiege.Health.MinionMultiplier   = 1.0
CitySiege.Health.DefenderMultiplier = 1.5

CitySiege.Damage.WarlordMultiplier  = 1.6
CitySiege.Damage.MiniBossMultiplier = 1.3
CitySiege.Damage.EliteMultiplier    = 1.1
CitySiege.Damage.MinionMultiplier   = 1.0
CitySiege.Damage.DefenderMultiplier = 1.0

#
#    CitySiege.Scale.*
#        Description: Model scale, purely visual, so officers stand out in a crowd.
CitySiege.Scale.Leader   = 1.6
CitySiege.Scale.MiniBoss = 1.3

###################################################################################################
# BRACKET HANDICAP
#
# Lets a player who is well below the army's level still fight and still matter: the army hits them
# softer and their own damage counts for more. Players at or near the army's level are unaffected.
###################################################################################################

#
#    CitySiege.Bracket.Enabled
#        Default:     1
CitySiege.Bracket.Enabled = 1

#
#    CitySiege.Bracket.FreeLevels
#        Description: Level difference tolerated before the handicap kicks in.
#        Default:     3
CitySiege.Bracket.FreeLevels = 3

#
#    CitySiege.Bracket.MinDamageTaken
#        Description: Floor on incoming damage, as a fraction. 0.15 means a badly under-levelled
#                     player never takes more than 15% of a normal hit.
#        Default:     0.15
CitySiege.Bracket.MinDamageTaken = 0.15

#
#    CitySiege.Bracket.MaxDamageBoost
#        Description: Cap on how much an under-levelled player's damage is multiplied.
#        Default:     8.0
CitySiege.Bracket.MaxDamageBoost = 8.0

###################################################################################################
# REINFORCEMENTS
###################################################################################################

CitySiege.Respawn.Enabled      = 1
CitySiege.Respawn.LeaderTime   = 300
CitySiege.Respawn.MiniBossTime = 180
CitySiege.Respawn.EliteTime    = 120
CitySiege.Respawn.MinionTime   = 60

###################################################################################################
# REWARDS
#
# Rewards go to players who actually took part - damage dealt to the war host, healing done in the
# battle, or killing blows - not to everyone standing in the city.
###################################################################################################

#
#    CitySiege.RewardOnDefense
#        Description: Master switch for rewards.
CitySiege.RewardOnDefense = 1

#
#    CitySiege.RewardHonor
#        Description: Honor granted to a participant on the winning side.
CitySiege.RewardHonor = 100

#
#    CitySiege.RewardGoldBase / CitySiege.RewardGoldPerLevel
#        Description: Copper granted as base + perLevel * playerLevel.
#                     Default is 0.5g + 0.5g per level, so 40.5g at level 80.
CitySiege.RewardGoldBase     = 5000
CitySiege.RewardGoldPerLevel = 5000

#
#    CitySiege.Reward.ExperienceEnabled / ExperiencePerLevel
#        Description: Experience granted as perLevel * playerLevel. This is what makes the event
#                     worth joining for a levelling character. Ignored at max level.
CitySiege.Reward.ExperienceEnabled = 1
CitySiege.Reward.ExperiencePerLevel = 400

#
#    CitySiege.Reward.ItemId / ItemCount
#        Description: Optional item handed to participants on the winning side. 0 disables it.
CitySiege.Reward.ItemId    = 0
CitySiege.Reward.ItemCount = 1

#
#    CitySiege.Reward.LosingSide / LoserFactor
#        Description: Give a reduced reward to participants whose side lost, so turning up is never
#                     a waste of time. LoserFactor scales honor, gold and experience.
CitySiege.Reward.LosingSide  = 1
CitySiege.Reward.LoserFactor = 0.35

#
#    CitySiege.Reward.ParticipationThreshold
#        Description: Minimum contribution score needed to count as a participant. The score is
#                     damage + healing/2 + 500 per killing blow.
#        Default:     1
CitySiege.Reward.ParticipationThreshold = 1

#
#    CitySiege.Reward.ParticipationWindow
#        Description: Seconds since a player's last contribution for it to still count at the end.
#        Default:     600
CitySiege.Reward.ParticipationWindow = 600

#
#    CitySiege.Reward.AnnounceTopContributors
#        Description: Name the three most valuable combatants when the siege ends.
CitySiege.Reward.AnnounceTopContributors = 1

###################################################################################################
# ATMOSPHERE
###################################################################################################

#
#    CitySiege.Weather.*
#        Description: Weather override for the duration of the siege. Type values:
#                     0 fine, 1 fog, 3 light rain, 4 medium rain, 5 heavy rain,
#                     6 light snow, 7 medium snow, 8 heavy snow,
#                     22 light sandstorm, 41 thunders, 42 blackrain.
#                     When the siege ends the zone is set back to fine and the normal weather
#                     system takes over again.
CitySiege.Weather.Enabled = 1
CitySiege.Weather.Type    = 5
CitySiege.Weather.Grade   = 0.9

#
#    CitySiege.Music.*
#        Description: SoundKit ids played at each beat of the siege. LoopSeconds re-sends the combat
#                     track so the battle never falls silent; 0 disables the loop.
CitySiege.Music.Enabled         = 1
CitySiege.Music.RPMusicId       = 11803
CitySiege.Music.CombatMusicId   = 11804
CitySiege.Music.VictoryMusicId  = 16039
CitySiege.Music.DefeatMusicId   = 14127
CitySiege.Music.LoopSeconds     = 120

###################################################################################################
# CLIENT ADDON BRIDGE
###################################################################################################

#
#    CitySiege.Addon.Enabled
#        Description: Send siege state to the CitySiege client addon.
CitySiege.Addon.Enabled = 1

#
#    CitySiege.Addon.UseSystemChannel
#        Description: Legacy transport. When 0 (the default) the data is sent as a hidden addon
#                     message, so players without the addon see nothing. Set to 1 only if your
#                     client build does not deliver addon messages; the raw protocol will then be
#                     visible in everyone's chat log.
CitySiege.Addon.UseSystemChannel = 0

#
#    CitySiege.Addon.BroadcastInterval
#        Description: Seconds between state updates pushed to the addon.
CitySiege.Addon.BroadcastInterval = 15

###################################################################################################
# TEXT
#
# Placeholders: {CITYNAME} / {CITY} for the city, {LEADER} for the city leader's name.
###################################################################################################

CitySiege.Message.SiegeStart = "|cffff0000[City Siege]|r The city of {CITYNAME} is under attack! Defenders are needed!"
CitySiege.Message.SiegeEnd = "|cff00ff00[City Siege]|r The siege of {CITYNAME} has ended!"
CitySiege.Message.Reward = "|cff00ff00[City Siege]|r You fought for {CITYNAME} and have been rewarded!"

#
#    CitySiege.Yell.LeaderSpawn
#        Description: Lines the warlord may shout when the army musters. Separated by semicolons.
CitySiege.Yell.LeaderSpawn = "This city will fall before our might!;Prepare to witness your doom!;We have come to raze your walls!;Today, {CITY} falls!;Your defenses will not hold!"

#
#    CitySiege.Yell.Combat
#        Description: Battle taunts from officers. Separated by semicolons.
CitySiege.Yell.Combat = "Your defenses crumble!;This city will burn!;Face your doom!;None can stand against us!;{LEADER} will fall with the rest of you!;Push on! The throne is within reach!"

#
#    CitySiege.RP.Alliance / CitySiege.RP.Horde
#        Description: Roleplay scripts delivered during the muster phase. Scripts are separated by
#                     a pipe (|) and one is chosen at random per siege; lines inside a script are
#                     separated by semicolons and are delivered in order.
CitySiege.RP.Alliance = "Citizens of {CITY}, your time has come! We march under the banner of the Alliance!;{LEADER}, your people cry out for mercy, but you have shown none to ours!;We have crossed mountains and seas to bring justice to {CITY}. Surrender now, or face annihilation!;The Light guides our blades, and the might of Stormwind stands behind us. Your defenses will crumble!;This ends today! {LEADER}, come forth and face the Alliance, or watch {CITY} burn!|The Alliance has gathered its greatest heroes for this assault on {CITY}. You cannot stand against us!;{LEADER}, your leadership has made the Horde enemies it cannot defeat! We will tear down these walls!;Too long have you raided our villages and slaughtered our people. Today, we bring the war to {CITY}!;Your shamans' magic cannot protect you. Our priests and paladins have blessed this army!;Prepare to face the wrath of the Alliance! {LEADER}, your reign over {CITY} ends here and now!|By order of the King, {CITY} is to be taken! Resistance is futile!;{LEADER}! Come forth and face us, or hide like a coward while your people suffer!;The Horde's reign of terror ends here at {CITY}. We will show no mercy to those who threaten peace!;Our siege engines are ready. The walls of {CITY} mean nothing to the might of the Alliance!;For every innocent killed by Horde aggression, {LEADER}, you will pay with your life!"

CitySiege.RP.Horde = "The Horde has come to claim {CITY}! Your precious Alliance ends today!;{LEADER}, you have oppressed our people for the last time! Come out and face your fate!;We are not savages - we are warriors! And today, we show {CITY} what true strength means!;Your guards are weak. Your walls are weak. {LEADER} hides in the throne room while we stand at the gates!;Blood and honor! Today we prove that the Horde is the superior force in Azeroth!|Citizens of {CITY}, flee while you can! We have come for your leaders, not for you!;{LEADER}! Your reign of tyranny over {CITY} ends today! The throne will belong to the Horde!;You call us monsters, but it is YOU who started this war! We finish it today at {CITY}!;The spirits of our ancestors guide us. No amount of Light magic will save {CITY} from our wrath!;Lok'tar Ogar! {LEADER}, today you fall, and the Horde claims {CITY}!|The Warchief has sent his finest warriors to end Alliance tyranny at {CITY} once and for all!;Your pitiful city guard cannot stop the Horde war machine! {LEADER}, your time has come!;We march for honor! We march for glory! We march to prove that the Horde will take {CITY}!;Every siege tower, every warrior, every drop of blood spilled today at {CITY} - it all leads to YOUR defeat!;{LEADER}, the Alliance has grown soft under your leadership. Today at {CITY}, the Horde reminds you why you should fear us!"

###################################################################################################
# PLAYERBOT INTEGRATION
#
# These settings do nothing unless mod-playerbots is installed and compiled in.
###################################################################################################

CitySiege.Playerbots.Enabled       = 0
CitySiege.Playerbots.MinLevel      = 50
CitySiege.Playerbots.MaxDefenders  = 20
CitySiege.Playerbots.MaxAttackers  = 20
CitySiege.Playerbots.RespawnDelay  = 30

#
#    CitySiege.Playerbots.OrderCooldown
#        Description: Minimum seconds between travel orders issued to a single bot.
#        Default:     8
CitySiege.Playerbots.OrderCooldown = 8
